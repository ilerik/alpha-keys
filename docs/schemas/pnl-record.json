{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-keys.local/schemas/pnl-record.json",
  "title": "PnlMetrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["pnl_usd_e6", "max_dd_bps", "sharpe_e4", "n_trades", "equity_usd_e6"],
