# Copy to .env (never commit .env). Names only; fill values locally.
# ---- NEAR ----
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=
# ed25519:... or ml-dsa-65:... from near-cli. Never commit this.
NEAR_PRIVATE_KEY=
CONTRACT_ID=alpha-keys.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
MINTER_ACCOUNT_ID=
MINTER_PRIVATE_KEY=
# ---- OutLayer ----
OUTLAYER_CONTRACT_ID=outlayer.testnet
OUTLAYER_API_BASE=https://testnet-api.outlayer.ai
OUTLAYER_PAYMENT_KEY=
OUTLAYER_PROJECT=
ATTESTOR_CODE_HASH=
# Hidden trader address: ONLY used by scripts/outlayer-publish.sh to set the OutLayer secret
HL_ADDRESS=
# ---- NEAR Intents 1Click ----
ONECLICK_BASE_URL=https://1click.chaindefuser.com/v0
ONECLICK_JWT=
ONECLICK_LIVE=0
TREASURY_ACCOUNT_ID=
HL_DEMO_RECIPIENT=
# ---- Gateway ----
GATEWAY_PORT=8787
GATEWAY_JWT_SECRET=demo-only-not-a-secret
DEMO_FEED=1
# ---- Copier (follower's own account) ----
FOLLOWER_HL_ADDRESS=
FOLLOWER_HL_API_WALLET_KEY=
COPIER_LIVE=0
# ---- Optional: NEAR AI Cloud / Agent API (stretch) ----
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
AGENT_API_ENABLED=0
AGENT_API_BASE=https://api.demo.agentsonintents.com
AGENT_API_KEY=
# ---- Web (public values only) ----
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_CONTRACT_ID=alpha-keys.testnet
NEXT_PUBLIC_PNL_TX=6uDLJJ5s9URhR79Gt6P97r9p54HPdgSEWWdgEuYpyekF
# Local Quickstart only. Leave this unset on Vercel.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
